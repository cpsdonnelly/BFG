+        strain += phase_weight(2 * j) * p_left * min(turns, 2) / 3.0 * hits_vp(target, gs, 1)
+    no_turn = crit_effect_value(target, "graviton_harness" if ct == "de_superstructure"
+                                else "mast_lines", gs, owner, end_phases)
+    return min(strain, no_turn)
